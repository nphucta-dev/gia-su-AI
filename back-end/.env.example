DATABASE_URL=mysql+pymysql://gia_su_ai:gia_su_ai_dev@localhost:3306/gia_su_ai?charset=utf8mb4
# Nếu dùng MySQL đã cài trên máy, thay user/mật khẩu ở trên bằng tài khoản của bạn.
# Ví dụ: mysql+pymysql://root:your_password@localhost:3306/gia_su_ai?charset=utf8mb4
# URL mysql:// từ dịch vụ MySQL và ?ssl-mode=REQUIRED được tự chuyển cho PyMySQL.
# Thay bằng khóa riêng ít nhất 32 ký tự trước khi chạy ứng dụng.
JWT_SECRET=replace-this-with-your-own-random-secret-at-least-32-characters
ACCESS_TOKEN_MINUTES=30
CORS_ORIGIN=http://127.0.0.1:4173,http://localhost:4173

# Seed mặc định có LEARNER và ADMIN mẫu trong app/db/seed.py.
# Tùy chọn: thêm ADMIN riêng bằng python -m app.db.seed --admin.
# Nếu bỏ trống các biến dưới, lệnh --admin sẽ hỏi email và mật khẩu.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Thư mục lưu PDF/TXT riêng của backend; đường dẫn tương đối tính từ back-end/.
UPLOAD_DIR=storage/documents

# Điền key, URL và tên model ở backend. Không đặt key trong frontend.
# URL có thể là endpoint đầy đủ hoặc base /v1. Auto nhận biết các chuẩn bên dưới.
# Ollama/local server không yêu cầu xác thực có thể để trống key.
LLM_API_KEY=
LLM_API_URL=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30
# Tùy chọn: auto, openai, openai_compatible, responses, gemini, anthropic, ollama.
# Với proxy tùy biến không nhận biết được từ URL, đặt đúng chuẩn API ở đây.
LLM_PROVIDER=auto
# Giới hạn đầu ra cho API Anthropic (các chuẩn khác dùng mặc định của nhà cung cấp).
LLM_MAX_TOKENS=4096
LLM_API_VERSION=2023-06-01
